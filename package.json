{
  "name": "revenda-radar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Comparador de precos e radar de oportunidades para revenda de usados (OLX, Enjoei, Facebook Marketplace)",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "comecar": "node bin/comecar.js",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "doctor": "node bin/doctor.js",
    "buscar": "node bin/scan.js",
    "atualizar": "node bin/refresh.js",
    "selftest": "node bin/selftest.js",
    "navegador": "playwright install chromium"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "optionalDependencies": {
    "playwright": "^1.49.1"
  }
}
