# ---------------------------------------------------------------
# Revenda Radar - configuracao
# Copie este arquivo para ".env" e ajuste os valores.
# ---------------------------------------------------------------

PORT=3000

# --- SUA REGIAO (usado para achar oportunidades perto de voce) ---
# UF: sigla do estado em minusculo. Ex: sp, rj, mg, ba, pr
UF=sp
# REGIAO: slug da regiao dentro da OLX. Ex: sao-paulo-e-regiao, baixada-santista,
# campinas-e-regiao, belo-horizonte-e-regiao, rio-de-janeiro-e-regiao.
# Deixe vazio para buscar no estado inteiro.
REGIAO=sao-paulo-e-regiao
# CIDADE: nome da sua cidade, usado so para ranquear o que esta mais perto.
CIDADE=Sao Paulo

# --- FONTES ---
FONTE_OLX=true
FONTE_ENJOEI=true
# Facebook Marketplace exige login e automacao de navegador. Leia o README
# antes de ligar: existe risco de restricao da sua conta.
FONTE_FACEBOOK=false

# --- COLETA ---
MAX_PAGINAS=2
DELAY_MS=1500
TIMEOUT_MS=30000
RETRIES=2
USAR_NAVEGADOR=true
HEADLESS=true
CACHE_MIN=180

# --- REGRAS DE NEGOCIO ---
# Voce quer vender um pouco abaixo da media para girar rapido: 0.08 = 8% abaixo.
DESCONTO_VENDA_RAPIDA=0.08
# Custo fixo por operacao (transporte, limpeza, embalagem) em R$.
CUSTO_FIXO=30
# Taxa da plataforma na venda (0 = OLX/Facebook presencial; 0.20 = Enjoei aprox).
TAXA_PLATAFORMA=0
# Filtros minimos para algo ser considerado oportunidade.
LUCRO_MINIMO=100
ROI_MINIMO=0.12

# --- ESTATISTICA ---
IQR_K=1.5
MIN_AMOSTRA=5
